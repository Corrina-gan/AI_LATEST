# Copy this file to .env and replace the placeholder.
# Do not commit a real key. .env is gitignored.

# The Movie Database (TMDB) v3 API key — optional, posters only.
# Get a free key: https://www.themoviedb.org/settings/api
# Leave unset (or keep the placeholder) to run the app without fetching posters.
TMDB_API_KEY=your_tmdb_api_key_here
